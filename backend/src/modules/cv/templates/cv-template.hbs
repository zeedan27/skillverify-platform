<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SkillVerify Certified Resume - {{fullName}}</title>
  <style>
    @page { size: A4; margin: 16mm; }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: #0f172a;
      background: #ffffff;
      margin: 0;
      padding: 0;
      font-size: 11pt;
      line-height: 1.55;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .resume-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2.5px solid #3b82f6;
      padding-bottom: 18px;
      margin-bottom: 22px;
    }
    .header-left { flex: 1; }
    .name {
      font-size: 24pt;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: #0f172a;
      margin: 0 0 4px 0;
    }
    .headline {
      font-size: 12pt;
      font-weight: 600;
      color: #2563eb;
      margin: 0 0 8px 0;
    }
    .contact-bar {
      font-size: 9.5pt;
      color: #64748b;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .contact-item { display: inline-flex; align-items: center; gap: 4px; }
    .verification-seal {
      width: 140px;
      background: #f0fdf4;
      border: 1.5px solid #86efac;
      border-radius: 12px;
      padding: 10px;
      text-align: center;
      margin-left: 16px;
    }
    .seal-badge {
      display: inline-block;
      background: #16a34a;
      color: white;
      font-size: 7.5pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 2px 8px;
      border-radius: 9999px;
      margin-bottom: 4px;
    }
    .seal-text {
      font-size: 8pt;
      color: #15803d;
      font-weight: 600;
      line-height: 1.2;
    }
    .section { margin-bottom: 18px; }
    .section-title {
      font-size: 11pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #1e3a8a;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 4px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .verification-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 4px solid #10b981;
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .verif-role { font-weight: 700; font-size: 10.5pt; color: #0f172a; }
    .verif-company { color: #64748b; font-size: 9pt; }
    .verif-score-box { text-align: right; }
    .verif-score {
      font-size: 13pt;
      font-weight: 800;
      color: #059669;
    }
    .verif-date { font-size: 8pt; color: #94a3b8; }
    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .skill-chip {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      font-size: 8.5pt;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 6px;
    }
    .entry-item { margin-bottom: 14px; }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .entry-title { font-weight: 700; color: #0f172a; font-size: 10.5pt; }
    .entry-dates { font-size: 9pt; color: #64748b; font-weight: 600; }
    .entry-subtitle { font-size: 9.5pt; color: #2563eb; font-weight: 600; margin-bottom: 3px; }
    .entry-desc { margin: 0; font-size: 9.5pt; color: #334155; line-height: 1.5; }
    .footer-stamp {
      margin-top: 30px;
      border-top: 1px dashed #cbd5e1;
      padding-top: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 8pt;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="resume-header">
    <div class="header-left">
      <h1 class="name">{{fullName}}</h1>
      {{#if headline}}<div class="headline">{{headline}}</div>{{/if}}
      <div class="contact-bar">
        <span class="contact-item">📧 {{email}}</span>
        <span class="contact-item">📱 {{phone}}</span>
      </div>
    </div>
    <div class="verification-seal">
      <div class="seal-badge">Verified</div>
      <div class="seal-text">SkillVerify Authenticated Application</div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Verified Skill Verifications</div>
    {{#if quizScores.length}}
      {{#each quizScores}}
        <div class="verification-card">
          <div>
            <div class="verif-role">{{this.jobTitle}}</div>
            <div class="verif-company">{{this.companyName}}</div>
          </div>
          <div class="verif-score-box">
            <div class="verif-score">{{this.score}}%</div>
            <div class="verif-date">Validated {{this.passedAt}}</div>
          </div>
        </div>
      {{/each}}
    {{else}}
      <div class="verification-card">
        <div>
          <div class="verif-role">Skill Gate Certified Candidate</div>
          <div class="verif-company">Verified via SkillVerify Fair-Hiring Pipeline</div>
        </div>
        <div class="verif-score-box">
          <div class="verif-score">PASSED</div>
          <div class="verif-date">Authenticated</div>
        </div>
      </div>
    {{/if}}
  </div>

  <div class="section">
    <div class="section-title">Core Competencies & Skills</div>
    <div class="skills-grid">
      {{#each skills}}
        <span class="skill-chip">{{this}}</span>
      {{/each}}
    </div>
  </div>

  {{#if experience.length}}
  <div class="section">
    <div class="section-title">Professional Experience</div>
    {{#each experience}}
      <div class="entry-item">
        <div class="entry-header">
          <span class="entry-title">{{this.title}}</span>
          <span class="entry-dates">{{this.startDate}} — {{#if this.isCurrent}}Present{{else}}{{this.endDate}}{{/if}}</span>
        </div>
        <div class="entry-subtitle">{{this.company}}</div>
        {{#if this.description}}<p class="entry-desc">{{this.description}}</p>{{/if}}
      </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if education.length}}
  <div class="section">
    <div class="section-title">Education & Credentials</div>
    {{#each education}}
      <div class="entry-item">
        <div class="entry-header">
          <span class="entry-title">{{this.degree}} in {{this.fieldOfStudy}}</span>
          <span class="entry-dates">{{this.startYear}} — {{#if this.isCurrent}}Present{{else}}{{this.endYear}}{{/if}}</span>
        </div>
        <div class="entry-subtitle">{{this.institution}}</div>
      </div>
    {{/each}}
  </div>
  {{/if}}

  <div class="footer-stamp">
    <span>SkillVerify Automated Candidate Passport • Tamper-Evident</span>
    <span>Generated: {{generatedAt}}</span>
  </div>
</body>
</html>
